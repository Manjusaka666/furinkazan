[
  {"id":"018376","slug":"momotaro","lv":"N4","cat":"tale","zh":"日本最家喻户晓的民间故事，楠山正雄为儿童改写，句子短，重复多，适合第一次读整篇日语。"},
  {"id":"043457","slug":"issun-boshi","lv":"N4","cat":"tale","zh":"一寸高的小人坐着碗去京都，打败了鬼。同样是楠山正雄的儿童版。"},
  {"id":"018337","slug":"kintaro","lv":"N4","cat":"tale","zh":"足柄山的怪力童子，日后成了源赖光的部下坂田金时。"},
  {"id":"003390","slug":"urashima","lv":"N4","cat":"tale","zh":"救龟、龙宫、玉手箱。这个故事在『日本書紀』和『万葉集』里就有早期形态，与中国的仙乡传说相通。"},
  {"id":"018378","slug":"shitakiri","lv":"N4","cat":"tale","zh":"善良的老爷爷和贪心的老奶奶，两只箱子的选择。"},
  {"id":"003391","slug":"hanasaka","lv":"N4","cat":"tale","zh":"让枯树开花的老爷爷，日本人讲善恶有报的典型。"},
  {"id":"000637","slug":"tebukuro","lv":"N3","cat":"child","zh":"小狐狸第一次去人类的町里买手套。新美南吉写的雪夜，语言干净，情感很轻。"},
  {"id":"000628","slug":"gongitsune","lv":"N3","cat":"child","zh":"日本小学语文课本的固定篇目。恶作剧的小狐狸想赎罪，结局让几代孩子难过。"},
  {"id":"000092","slug":"kumo-no-ito","lv":"N3","cat":"child","zh":"芥川龙之介的短篇，释迦从极乐垂下一根蛛丝。不长，第一次读芥川可以从这里开始。"},
  {"id":"043015","slug":"toshishun","lv":"N3","cat":"china","zh":"芥川据唐代传奇『杜子春伝』改写，故事发生在洛阳，结局却和原作相反。可以和中文原文对读。"},
  {"id":"043754","slug":"chumon","lv":"N3","cat":"child","zh":"宫泽贤治的童话：两个打猎的绅士走进一家「要求很多」的餐馆。"},
  {"id":"001567","slug":"merosu","lv":"N3","cat":"modern","zh":"太宰治改写自席勒的诗，讲信义与友情。节奏很快，是日本中学的经典课文。"},
  {"id":"000127","slug":"rashomon","lv":"N2","cat":"modern","zh":"芥川的成名作，取材于『今昔物語集』，写平安京末世里一个家仆的选择。"},
  {"id":"000042","slug":"hana","lv":"N2","cat":"modern","zh":"长鼻子的僧人和他的烦恼，漱石读后写信称赞。同样出自『今昔物語集』。"},
  {"id":"000799","slug":"yume-juya","lv":"N2","cat":"modern","zh":"夏目漱石记下的十个梦。第一夜的等待和百合最常被引用。"},
  {"id":"000624","slug":"sangetsuki","lv":"N2","cat":"china","zh":"中岛敦改写自唐传奇『人虎伝』：陇西的李徵因诗名不成而化虎。日本高中语文的必读篇目，汉文气息浓厚。"},
  {"id":"000621","slug":"meijinden","lv":"N2","cat":"china","zh":"取材于『列子』中飞卫、纪昌的射箭故事。中岛敦把「不射之射」写到了极致。"},
  {"id":"001071","slug":"kanzan","lv":"N2","cat":"china","zh":"森鸥外写唐代诗僧寒山与拾得，据『寒山詩集』序改写。"},
  {"id":"001047","slug":"chikusei","lv":"N2","cat":"china","zh":"太宰治据蒲松龄『聊斎志異』「竹青」改写，把故事放回湖南洞庭。"},
  {"id":"001358","slug":"okehazama","lv":"N2","cat":"sengoku","zh":"永禄三年（1560），二十七岁的信长以少数奇袭今川义元。菊池宽『日本合戦譚』的一篇，叙述清楚，是读战国史最好的入口。"},
  {"id":"001355","slug":"anegawa","lv":"N2","cat":"sengoku","zh":"元龟元年（1570），织田·德川联军对浅井·朝仓联军。"},
  {"id":"001357","slug":"kawanakajima","lv":"N2","cat":"sengoku","zh":"信玄与谦信在信浓的五度对阵，永禄四年（1561）的第四次最为激烈，「车悬之阵」「啄木鸟战法」都出自这里的传说。"},
  {"id":"001360","slug":"nagashino","lv":"N2","cat":"sengoku","zh":"天正三年（1575），织田·德川联军以马防栅和铁炮击败武田胜赖。"},
  {"id":"001356","slug":"itsukushima","lv":"N2","cat":"sengoku","zh":"天文二十四年（1555），毛利元就以奇袭击败陶晴贤，中国地方的霸权由此易手。"},
  {"id":"001364","slug":"yamazaki","lv":"N2","cat":"sengoku","zh":"本能寺之变十一天后，秀吉「中国大返还」归来，在山崎击败明智光秀。"},
  {"id":"001361","slug":"shizugatake","lv":"N2","cat":"sengoku","zh":"天正十一年（1583），秀吉与柴田胜家争夺信长的遗产，「贱岳七本枪」由此得名。"},
  {"id":"001370","slug":"odawara","lv":"N2","cat":"sengoku","zh":"天正十八年（1590），秀吉围北条氏小田原，伊达政宗穿白装束来降，天下统一。"},
  {"id":"001362","slug":"hekiteikan","lv":"N1","cat":"sengoku","zh":"文禄二年（1593）壬辰战争中的碧蹄馆之战，日军对李如松率领的明军。是中日韩三国史的交汇处。"},
  {"id":"001366","slug":"osaka-natsu","lv":"N2","cat":"sengoku","zh":"元和元年（1615），大坂城陷落，丰臣氏灭亡，战国时代真正结束。"},
  {"id":"001367","slug":"sanada","lv":"N2","cat":"sengoku","zh":"真田幸村（信繁）与大坂之阵，他冲到家康本阵的故事让他成了「日本第一兵」。"},
  {"id":"001368","slug":"onin","lv":"N2","cat":"sengoku","zh":"应仁元年（1467）开始的十一年内乱，京都成为废墟，战国的序幕。"},
  {"id":"001363","slug":"shimabara","lv":"N2","cat":"sengoku","zh":"宽永十四年（1637）的天草·岛原之乱，战国余波与禁教。"},
  {"id":"043138","slug":"oda-nobunaga","lv":"N1","cat":"sengoku","zh":"坂口安吾笔下的青年信长：不讲究礼法、爱热闹的「大傻瓜」。语言粗粝有力，和教科书完全不同。"},
  {"id":"057478","slug":"ieyasu","lv":"N1","cat":"sengoku","zh":"坂口安吾的史论：他不信「隐忍的家康」这个形象，写法尖锐。"},
  {"id":"042952","slug":"kessen-kawanakajima","lv":"N1","cat":"sengoku","zh":"坂口安吾的未完成历史小说，以上杉谦信为中心写川中岛。"},
  {"id":"042919","slug":"niryu","lv":"N1","cat":"sengoku","zh":"以黑田如水为主角写秀吉、家康时代，安吾代表作之一。新字旧假名，读起来稍吃力。"},
  {"id":"002709","slug":"gamo","lv":"N1","cat":"sengoku","zh":"幸田露伴写信长的女婿蒲生氏郷，文气古朴，夹杂大量汉语词。"},
  {"id":"000058","slug":"itojo","lv":"N1","cat":"sengoku","zh":"芥川用侍女的口吻写细川ガラシャ（明智光秀之女）之死，日期就在关原之战前夕。新字旧假名。"},
  {"id":"001738","slug":"deshi","lv":"N1","cat":"china","zh":"中岛敦写孔子和子路。对读『論語』特别有味道。"},
  {"id":"001737","slug":"riryo","lv":"N1","cat":"china","zh":"李陵、苏武、司马迁三个人的命运，据『漢書』和『史記』写成，中岛敦的绝笔。"},
  {"id":"002051","slug":"gyogenki","lv":"N1","cat":"china","zh":"森鸥外写晚唐女诗人鱼玄机，文体简净，用的是『三水小牍』等史料。"},
  {"id":"046930","slug":"soshi","lv":"N1","cat":"china","zh":"冈本かの子以小说写庄子，与『荘子』的寓言相映。"},
  {"id":"001452","slug":"unmei","lv":"N1","cat":"china","zh":"幸田露伴写明初建文帝与燕王（永乐帝）的靖难之役，汉文训读调，是近代日本汉文素养的高峰之一。"},
  {"id":"001276","slug":"chanohon","lv":"N1","cat":"china","zh":"岡倉天心原著英文，村冈博译。从唐代陆羽讲到宋代与日本茶道，是谈东方美学的名著。"},
  {"id":"000393","slug":"iki","lv":"N1","cat":"essay","zh":"九鬼周造用哲学分析江户美意识「いき」。很难，但读懂一段就很有收获。"},
  {"id":"018334","slug":"sarukani","lv":"N4","cat":"tale","zh":"猿蟹合战，猴子骗了螃蟹，小伙伴们替它报仇。"},
  {"id":"050756","slug":"hachikatsugi","lv":"N4","cat":"tale","zh":"头上戴着钵子摘不下来的姑娘，中世流传的御伽草子。"},
  {"id":"018336","slug":"bunbuku","lv":"N4","cat":"tale","zh":"变成茶壶的狸猫，在寺里被烧得跳起来。"},
  {"id":"043459","slug":"uriko","lv":"N4","cat":"tale","zh":"从瓜里出生的女孩和山妖天邪鬼。"},
  {"id":"018339","slug":"oeyama","lv":"N3","cat":"tale","zh":"源赖光大江山退治酒吞童子，日本最有名的鬼故事。读过它再看《鬼灭之刃》会多一层味道。"},
  {"id":"033208","slug":"adachigahara","lv":"N3","cat":"tale","zh":"安达原的鬼婆传说，能和歌舞伎都有这个题目。"},
  {"id":"018382","slug":"tamura","lv":"N3","cat":"tale","zh":"坂上田村麻吕东征的传说。"},
  {"id":"018383","slug":"chinzei","lv":"N3","cat":"tale","zh":"镇西八郎源为朝，保元之乱中的神射手。"},
  {"id":"000635","slug":"ojiisan-lamp","lv":"N3","cat":"child","zh":"卖煤油灯的老爷爷遇上了电灯时代，新美南吉最动人的故事之一。"},
  {"id":"000638","slug":"tsubaki","lv":"N3","cat":"child","zh":"拉车人想在路边挖一口井，朴素而温暖。"},
  {"id":"000630","slug":"hananoki","lv":"N3","cat":"child","zh":"五个盗贼来到花之木村，却被一个孩子改变了。"},
  {"id":"004253","slug":"akatonbo","lv":"N3","cat":"child","zh":"一只红蜻蜓和少女，新美南吉的小品，很短。"},
  {"id":"000473","slug":"yodaka","lv":"N3","cat":"child","zh":"被所有鸟嘲笑的夜鹰，飞向星空。宫泽贤治的代表童话。"},
  {"id":"000470","slug":"gauche","lv":"N3","cat":"child","zh":"拉大提琴的果修和夜里来访的动物，吉卜力的高畑勋把它拍成了动画。"},
  {"id":"000472","slug":"yamanashi","lv":"N3","cat":"child","zh":"两只小螃蟹眼中的水底世界，日本小学语文的名篇。"},
  {"id":"001925","slug":"donguri","lv":"N3","cat":"child","zh":"橡子们争论谁最了不起，请一郎来判决。"},
  {"id":"000462","slug":"matasaburo","lv":"N2","cat":"child","zh":"风一样的转学生，贤治的长篇童话，开头的风之歌非常有名。"},
  {"id":"048222","slug":"ginga","lv":"N2","cat":"child","zh":"『银河铁道之夜』，日本人读了近一百年的幻想小说，松本零士的《银河铁道 999》也受它影响。"},
  {"id":"001924","slug":"budori","lv":"N2","cat":"child","zh":"森林里长大的孤儿投身改变寒冷的气候。"},
  {"id":"000211","slug":"ichifusa","lv":"N3","cat":"child","zh":"有岛武郎写给孩子的短篇：偷了同学的颜料之后。"},
  {"id":"043016","slug":"torokko","lv":"N3","cat":"child","zh":"八岁的孩子跟着矿车走得太远，回家的路突然变得可怕。短而有力。"},
  {"id":"000149","slug":"shiro-inu","lv":"N3","cat":"child","zh":"一只白狗变成了黑狗，芥川给孩子写的故事。"},
  {"id":"000752","slug":"botchan","lv":"N2","cat":"modern","zh":"『哥儿』，漱石最受欢迎的小说之一，鲁莽的东京青年到松山教书，天妇罗荞麦和丸子都有戏份。"},
  {"id":"000773","slug":"kokoro","lv":"N2","cat":"modern","zh":"『心』，日本最畅销的小说之一，先生和他的秘密。"},
  {"id":"000776","slug":"kusamakura","lv":"N1","cat":"modern","zh":"『草枕』，开头「智に働けば角が立つ」是日本人都会背的名句，汉诗文气息浓厚。"},
  {"id":"000753","slug":"buncho","lv":"N2","cat":"modern","zh":"漱石养的一只文鸟，安静的小品。"},
  {"id":"000760","slug":"garasudo","lv":"N2","cat":"modern","zh":"漱石晚年的随笔，窗内看窗外。"},
  {"id":"000179","slug":"yabu","lv":"N2","cat":"modern","zh":"三个人讲述同一桩命案，每个人的说法都不一样，黑泽明的电影《罗生门》其实取材于此。"},
  {"id":"000098","slug":"mikan","lv":"N2","cat":"modern","zh":"火车上的一个小姑娘和几只橘子，几页纸写完，日本语文课本的名篇。"},
  {"id":"000069","slug":"kappa","lv":"N1","cat":"modern","zh":"掉进河童之国的讽刺小说，芥川晚年的代表作。"},
  {"id":"000061","slug":"jigokuhen","lv":"N1","cat":"modern","zh":"为了画地狱图，画师看着女儿被烧。取材于『宇治拾遗物语』，旧字旧假名。"},
  {"id":"000055","slug":"imogayu","lv":"N2","cat":"modern","zh":"一个小官吏的愿望：喝个够的山药粥。"},
  {"id":"000301","slug":"ningen-shikkaku","lv":"N2","cat":"modern","zh":"『人间失格』，太宰治的绝笔之作，日本销量最高的小说之一。"},
  {"id":"001565","slug":"shayo","lv":"N2","cat":"modern","zh":"『斜阳』，战后没落的贵族之家，「斜阳族」这个词由此而来。"},
  {"id":"000270","slug":"fugaku","lv":"N2","cat":"modern","zh":"『富岳百景』，太宰在富士山下的日子。"},
  {"id":"002282","slug":"tsugaru","lv":"N2","cat":"modern","zh":"『津轻』，太宰回到故乡的游记。"},
  {"id":"000275","slug":"joseito","lv":"N2","cat":"modern","zh":"一个少女从早到晚的独白，太宰模仿女性读者的日记写成。"},
  {"id":"000277","slug":"kakekomi","lv":"N2","cat":"modern","zh":"犹大对主的控告，一口气读完的独白。"},
  {"id":"000682","slug":"maihime","lv":"N1","cat":"modern","zh":"『舞姬』，留学柏林的官僚和舞女，近代文学的起点之一，文语文体。"},
  {"id":"000691","slug":"takasebune","lv":"N2","cat":"modern","zh":"押送犯人的小船上的一场对话，讨论满足和安乐死。"},
  {"id":"000689","slug":"sansho","lv":"N2","cat":"modern","zh":"安寿与厨子王的故事，鸥外改写的中世说话。"},
  {"id":"000673","slug":"abe","lv":"N1","cat":"modern","zh":"殉死的武士一家，历史小说的典范。"},
  {"id":"056041","slug":"takekurabe","lv":"N1","cat":"modern","zh":"吉原附近孩子们的青春，樋口一葉的代表作。她的头像印在五千日元纸币上。"},
  {"id":"046349","slug":"lemon","lv":"N2","cat":"modern","zh":"『柠檬』，把一只柠檬放在丸善书店的书堆上。"},
  {"id":"047552","slug":"sakura-no-ki","lv":"N2","cat":"modern","zh":"「樱花树下埋着尸体！」，很短。"},
  {"id":"042618","slug":"sakura-mori","lv":"N2","cat":"modern","zh":"『盛开的樱花林下』，山贼和美丽可怕的女人，安吾最有名的小说。"},
  {"id":"042614","slug":"yonaga","lv":"N2","cat":"modern","zh":"夜长姬和雕刻匠耳男，残酷的童话。"},
  {"id":"004803","slug":"kazetachinu","lv":"N2","cat":"modern","zh":"『起风了』，堀辰雄的代表作，宫崎骏同名电影的来源之一。"},
  {"id":"001465","slug":"kanikosen","lv":"N2","cat":"modern","zh":"『蟹工船』，无产阶级文学的代表作。"},
  {"id":"000641","slug":"nekomachi","lv":"N2","cat":"modern","zh":"诗人萩原朔太郎写的迷路小说：猫之町。"},
  {"id":"043466","slug":"koya","lv":"N1","cat":"modern","zh":"『高野圣』，旅僧在深山里遇到的妖艳女子。泉镜花的代表作。"},
  {"id":"000329","slug":"musashino","lv":"N2","cat":"modern","zh":"『武藏野』，明治时代的东京郊外杂木林。"},
  {"id":"001669","slug":"futon","lv":"N2","cat":"modern","zh":"『棉被』，日本自然主义的代表作。"},
  {"id":"050351","slug":"gojunoto","lv":"N1","cat":"modern","zh":"『五重塔』，木匠十兵卫的执着，露伴的代表作。"},
  {"id":"002521","slug":"gojo-shusse","lv":"N1","cat":"china","zh":"中岛敦写《西游记》里的沙悟净。读过龙珠的话可以读读这个。"},
  {"id":"000617","slug":"gojo-tani","lv":"N1","cat":"china","zh":"沙悟净眼中的孙悟空和唐僧，上一篇的续作。"},
  {"id":"002325","slug":"sennin","lv":"N2","cat":"china","zh":"芥川写的中国仙人小品。"},
  {"id":"000161","slug":"shuchu","lv":"N2","cat":"china","zh":"芥川据『聊斋志异』「酒虫」改写。"},
  {"id":"000105","slug":"nankin","lv":"N2","cat":"china","zh":"南京的少女和一个外国人，芥川的中国题材短篇。"},
  {"id":"000024","slug":"bisei","lv":"N2","cat":"china","zh":"『庄子』里抱柱而死的尾生，只有两页。"},
  {"id":"000490","slug":"miura","lv":"N2","cat":"sengoku","zh":"今川氏的败亡中，一个小姓的结局。菊池宽的短篇。"},
  {"id":"045885","slug":"kuroda","lv":"N1","cat":"sengoku","zh":"坂口安吾写黑田如水，和『二流の人』相互补充。"},
  {"id":"001715","slug":"ganryu","lv":"N1","cat":"sengoku","zh":"直木三十五写宫本武藏和佐佐木小次郎，直木奖就是纪念他的。"},
  {"id":"000501","slug":"tadanao","lv":"N2","cat":"sengoku","zh":"大坂之阵后的松平忠直，自负的武士的悲剧。"},
  {"id":"000496","slug":"onshu","lv":"N2","cat":"sengoku","zh":"『恩讐の彼方に』，江户时代为赎罪挖隧道的僧人，耶马溪的青之洞门。"},
  {"id":"002255","slug":"udaijin","lv":"N1","cat":"sengoku","zh":"太宰治写镰仓第三代将军源实朝，就是荣西献茶的那位。"},
  {"id":"001293","slug":"hanshichi","lv":"N1","cat":"sengoku","zh":"『半七捕物帐』第一篇「お文の魂」，江户捕快半七登场，日本捕物小说的开山之作。"},
  {"id":"001734","slug":"onin-naito","lv":"N1","cat":"sengoku","zh":"内藤湖南的著名演讲，说要了解今日日本，读到应仁之乱就够了。"},
  {"id":"050326","slug":"yukionna","lv":"N3","cat":"kaidan","zh":"小泉八雲『怪谈』里的雪女。一个外国人写下的日本传说。"},
  {"id":"042927","slug":"hoichi","lv":"N2","cat":"kaidan","zh":"无耳芳一，为平家亡灵弹琵琶的盲僧。"},
  {"id":"050327","slug":"rokurokubi","lv":"N2","cat":"kaidan","zh":"长脖子的妖怪和一位武士出身的和尚。"},
  {"id":"002577","slug":"botan","lv":"N1","cat":"kaidan","zh":"三遊亭圓朝的落语速记本，开创了言文一致的文体。源头是中国明代『剪灯新话』的「牡丹灯记」。"},
