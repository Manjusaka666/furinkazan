---
import '../styles/global.css';
import latin from '../assets/fonts/latin.woff2?url';
import kana from '../assets/fonts/kana.woff2?url';
import brush from '../assets/fonts/brush-core.woff2?url';

const { title, desc, stage, home = false, sysJa = false } = Astro.props;
const fullTitle = home ? title : `${title} | 風林火山`;
const path = Astro.url.pathname;
const nav = [
  ['/kana/', '假名'],
  ['/learn/', '课程'],
  ['/scenes/', '情景'],
  ['/anime/', '动漫'],
  ['/words/', '词汇'],
  ['/kanji/', '汉字'],
  ['/grammar/', '语法'],
  ['/library/', '文库'],
  ['/culture/', '文化'],
  ['/review/', '复习'],
];
const rules = JSON.stringify({ prerender: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }] });
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#f3f1e6" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <link rel="preload" href={latin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={kana} as="font" type="font/woff2" crossorigin />
    {home && <link rel="preload" href={brush} as="font" type="font/woff2" crossorigin />}
    <script type="speculationrules" set:html={rules} is:inline></script>
  </head>
  <body class:list={[{ home, 'sys-ja': sysJa }]} data-stage={stage}>
    <a class="skip" href="#main">跳到正文</a>
    <header class="top">
      <a class="logo brush" href="/" lang="ja">風林火山</a>
      <nav aria-label="主导航">
        {nav.map(([href, label]) => (
          <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <p>例句来自 Tatoeba，读物来自青空文库，都是母语者写的公开文本；中文讲解和练习题由本站编写，未经母语教师审校。罗马音由程序生成，以假名为准。不用注册，进度只保存在这个浏览器里。</p>
      <p><a href="/history/">日本史年表</a>　<a href="/sources/">资料来源与致谢</a></p>
    </footer>
    <div class="toast" role="status" aria-live="polite" id="toast"></div>
    <script>import '../scripts/app.js';</script>
  </body>
</html>
