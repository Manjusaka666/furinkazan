---
import Examples from './Examples.astro';
import Voice from './Voice.astro';
import Say from './Say.astro';
import { romanize } from '../lib/romaji.js';
import { gloss, auOf } from '../data/course/index.js';

const { words, id } = Astro.props;
---
<section class="sec">
  <div class="sec-h"><h2 lang="ja">言葉</h2><span>带虚线的词可以点击听录音，例句全部来自声明为母语者的作者</span></div>
  {words.map((w) => (
    <div class="word">
      <h3 class="word-h">
        <Say ja={w.ja} au={auOf(w)} cls="term" />
        <span class="ro">{romanize(w.ja)}</span><Voice au={auOf(w)} />
      </h3>
      <p class="gloss">{gloss(w)} <button type="button" class="add" data-add={w.w}>加入复习</button></p>
      {w.ex.length > 0 && <Examples ex={w.ex} />}
    </div>
  ))}
</section>
<div class="finish">
  <button type="button" class="btn" data-finish={id} data-vocab={JSON.stringify(words.map((w) => w.w))} data-done-text="都已加入复习">全部加入复习</button>
  <slot />
</div>
