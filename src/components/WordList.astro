---
import Examples from './Examples.astro';
import { ruby } from '../lib/ruby.js';
import { romanize } from '../lib/romaji.js';
import { gloss, quizOf } from '../data/course/index.js';

const { words, id } = Astro.props;
---
<section class="sec">
  <div class="sec-h"><h2 lang="ja">言葉</h2><span>点词听发音，例句全部来自母语者</span></div>
  {words.map((w) => (
    <div class="word">
      <h3 class="word-h">
        <button type="button" class="term" lang="ja" data-say={w.w} set:html={ruby(w.ja)} />
        <span class="ro">{romanize(w.ja)}</span>
      </h3>
      <p class="gloss">{gloss(w)} <button type="button" class="add" data-add={w.w}>加入复习</button></p>
      {w.ex.length > 0 && <Examples ex={w.ex} />}
    </div>
  ))}
</section>
<section class="sec">
  <div class="sec-h"><h2 lang="ja">練習</h2><span>这些词是什么意思</span></div>
  {quizOf(words, id.length).map((q) => (
    <div class="q" data-quiz data-c={q.c} data-why={q.why}>
      <p lang="ja" set:html={ruby(q.ja)} />
      <div class="opts">
        {q.o.map((o, i) => <button type="button" class="opt" data-i={i}>{o}</button>)}
      </div>
    </div>
  ))}
</section>
<div class="finish">
  <button type="button" class="btn" data-finish={id} data-vocab={JSON.stringify(words.map((w) => w.w))} data-done-text="都已加入复习">全部加入复习</button>
  <slot />
</div>
