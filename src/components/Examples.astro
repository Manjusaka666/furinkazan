---
import Say from './Say.astro';
import { romanize } from '../lib/romaji.js';
import { sentenceAudio, creditOf } from '../data/course/index.js';

const { ex } = Astro.props;
---
<ul class="lines solo examples">
  {ex.map((e) => (
    <li>
      <div>
        <Say ja={e.ja} au={sentenceAudio[e.id]?.[0]} cls="say-line" />
        <p class="ro">{romanize(e.ja)}</p>
        {e.zh && <p class="zh">{e.zh}</p>}
        <p class="ex-src"><a href={`https://tatoeba.org/sentences/show/${e.id}`} rel="noopener">Tatoeba #{e.id}</a>，{e.by}{creditOf(e.id) && `。${creditOf(e.id)}`}</p>
      </div>
    </li>
  ))}
</ul>
