---
import Base from '../../../layouts/Base.astro';
import Examples from '../../../components/Examples.astro';
import { LEVELS, unitsOf, gloss, quizOf } from '../../../data/course/index.js';
import { ruby } from '../../../lib/ruby.js';

export const getStaticPaths = () =>
  Object.keys(LEVELS).flatMap((level) => {
    const units = unitsOf(level);
    return units.map((words, i) => ({ params: { level, unit: String(i + 1) }, props: { words, n: i + 1, total: units.length } }));
  });

const { level } = Astro.params;
const { words, n, total } = Astro.props;
const lv = LEVELS[level];
---
<Base title={`${lv.name} 第 ${n} 组`} desc={`${lv.name} 词汇第 ${n} 组：${words.slice(0, 5).map((w) => w.w).join('、')}。`} stage={lv.stage} sysJa>
  <header class="lesson-head">
    <p class="crumb"><a href={`/levels/${level}/`}>{lv.name}</a>　第 {n} 组，共 {total} 组</p>
    <h1>{lv.name} 第 {n} 组</h1>
  </header>
  <div class="controls" role="group" aria-label="显示选项">
    <label><input type="checkbox" data-pref="hide-rt" />隐藏假名注音</label>
    <label><input type="checkbox" data-pref="hide-zh" />隐藏中文，先靠听</label>
  </div>
  <article class="unit">
    <section class="sec">
      {words.map((w) => (
        <div class="word">
          <h2><button type="button" class="term" lang="ja" data-say={w.w} set:html={ruby(w.ja)} /></h2>
          <p class="gloss">{gloss(w)}</p>
          {w.ex.length > 0 && <Examples ex={w.ex} />}
        </div>
      ))}
    </section>
    <section class="sec">
      <div class="sec-h"><h2 lang="ja">練習</h2><span>这几个词是什么意思</span></div>
      {quizOf(words, n).map((q) => (
        <div class="q" data-quiz data-c={q.c} data-why={q.why}>
          <p lang="ja" set:html={ruby(q.ja)} />
          <div class="opts">
            {q.o.map((o, i) => <button type="button" class="opt" data-i={i}>{o}</button>)}
          </div>
        </div>
      ))}
    </section>
    <div class="finish">
      <button type="button" class="btn" data-finish={`${level}-${n}`} data-vocab={JSON.stringify(words.map((w) => w.w))}>学完这组，加入复习</button>
      {n < total ? <a href={`/levels/${level}/${n + 1}/`}>下一组</a> : <a href={`/levels/${level}/`}>回到 {lv.name}</a>}
    </div>
  </article>
</Base>
