---
import Base from '../../../layouts/Base.astro';
import Enso from '../../../components/Enso.astro';
import { LEVELS, unitsOf, grammarOf } from '../../../data/course/index.js';
import { STAGES } from '../../../data/lessons/index.js';

export const getStaticPaths = () => Object.keys(LEVELS).map((level) => ({ params: { level } }));

const { level } = Astro.params;
const lv = LEVELS[level];
const units = unitsOf(level);
---
<Base title={`${lv.name} 词汇与语法`} desc={`${lv.name}：${lv.words.length} 个词，按常用程度分成 ${units.length} 组，配母语者例句。`} stage={lv.stage} sysJa>
  <div class="page-head">
    <p class="crumb"><a href={`/learn/#${lv.stage}`}>{STAGES[lv.stage].kanji}・{STAGES[lv.stage].name}</a></p>
    <h1>{lv.name}</h1>
    <p>{lv.desc}{lv.words.length} 个词，常用的排在前面，每组 20 个，想学几组就学几组。词表来自社区整理的 JLPT 分级词表，JLPT 官方并不公布词表。</p>
    <p><a href={`/levels/${level}/grammar/`}>{lv.name} 语法：{grammarOf(level).length} 个句型</a></p>
  </div>
  <section class="stage-block">
    <ol class="lesson-list units">
      {units.map((unit, i) => (
        <li>
          <a href={`/levels/${level}/${i + 1}/`} data-lesson={`${level}-${i + 1}`}>
            <Enso />
            <span class="l-n">{i + 1}</span>
            <span class="l-title"><span lang="ja">{unit.slice(0, 3).map((w) => w.w).join('、')}</span></span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
