---
import Base from '../../layouts/Base.astro';
import { lessons, STAGES } from '../../data/lessons/index.js';
import { ruby, plain } from '../../lib/ruby.js';
import { rich } from '../../lib/term.js';
import { romanize } from '../../lib/romaji.js';
import { GOJUON, DAKUON } from '../../lib/kana.js';
import Controls from '../../components/Controls.astro';
import KanaPad from '../../components/KanaPad.astro';
import { lessonExamples } from '../../data/course/index.js';
import Examples from '../../components/Examples.astro';

export const getStaticPaths = () =>
  lessons.map((l, i) => ({ params: { slug: l.slug }, props: { l, prev: lessons[i - 1], next: lessons[i + 1] } }));

const { l, prev, next } = Astro.props;
const s = STAGES[l.stage];
const PAD = { 'hiragana-1': [GOJUON.slice(0, 5)], 'hiragana-2': [GOJUON.slice(5)], 'sounds-2': [DAKUON], katakana: [GOJUON, 'kata'] }[l.slug];
const pad = String(l.irodori ?? 0).padStart(2, '0');
const dialog = l.dialog ?? [];
const isSolo = dialog.every(([who]) => !who);
const native = lessonExamples[l.slug];
const vocabIds = l.vocab.map(([ja]) => plain(ja));
---
<Base title={`第 ${l.n} 课 ${plain(l.title)}`} desc={`${l.zh}。${l.can}`} stage={l.stage}>
  <header class="lesson-head">
    <p class="crumb"><a href={`/learn/#${l.stage}`}>{s.kanji}・{s.name}</a>　第 {l.n} 课</p>
    <h1 class="brush" lang="ja" set:html={ruby(l.title)} />
    <p class="ro head-ro">{romanize(l.title)}</p>
    <p class="sub">{l.zh}</p>
  </header>
  <Controls />
  <div class="lesson-grid">
    <article>
      {PAD && <KanaPad rows={PAD[0]} script={PAD[1]} />}
      {native ? (
        <section class="sec">
          <div class="sec-h"><h2 lang="ja">例文</h2><span>母语者写的句子，点一下听发音</span></div>
          <Examples ex={native} />
        </section>
      ) : (
      <section class="sec">
        <div class="sec-h"><h2 lang="ja">会話</h2><span>点句子听发音</span></div>
        <ol class:list={['lines', { solo: isSolo }]}>
          {dialog.map(([who, ja, zh]) => (
            <li>
              {who && <span class="who" lang="ja">{who}</span>}
              <div>
                <button type="button" class="say-line" lang="ja" data-say={plain(ja)} set:html={ruby(ja)} />
                <p class="ro">{romanize(ja)}</p>
                <p class="zh">{zh}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
      )}

      <section class="sec">
        <div class="sec-h"><h2 lang="ja">言葉</h2><span>词汇</span></div>
        <dl class="vocab">
          {l.vocab.map(([ja, zh]) => (
            <div>
              <dt><button type="button" class="term" lang="ja" data-say={plain(ja)} set:html={ruby(ja)} /></dt>
              <dd class="ro">{romanize(ja)}</dd>
              <dd>{zh}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="sec">
        <div class="sec-h"><h2 lang="ja">文法</h2><span>{l.stage === 'wind' ? '发音与文字要点' : '语法要点'}</span></div>
        {l.grammar.map((g) => (
          <div class="point">
            <h3 set:html={rich(g.p)} />
            <p set:html={rich(g.x)} />
          </div>
        ))}
      </section>

      <section class="sec">
        <div class="sec-h"><h2 lang="ja">練習</h2><span>练习</span></div>
        {l.quiz.map((q) => (
          <div class="q" data-quiz data-c={q.c} data-why={q.why}>
            <p set:html={rich(q.q, { ro: false })} />
            <div class="opts">
              {q.o.map((o, i) => <button type="button" class="opt" lang={q.ja ? 'ja' : undefined} data-i={i} set:html={rich(o, { ro: false })} />)}
            </div>
          </div>
        ))}
      </section>

      <section class="sec window">
        <h2 lang="ja">文化の窓</h2>
        <p><strong>{l.win.t}</strong></p>
        <p set:html={rich(l.win.b)} />
        <p><a href={`/culture/${l.win.to}/`}>读这篇短文</a></p>
      </section>

      <div class="finish">
        <button type="button" class="btn" data-finish={l.slug} data-vocab={JSON.stringify(vocabIds)}>完成本课，生词加入复习</button>
        {next && <a href={`/learn/${next.slug}/`}>下一课：<span lang="ja" set:html={ruby(next.title)} /></a>}
      </div>
    </article>

    <aside class="side">
      <section>
        <h2>学完你能</h2>
        <p>{l.can}</p>
      </section>
      <section>
        <h2>配合原声学习</h2>
        <ul>
          {l.irodori !== undefined && (
            <>
              <li><a href={`https://www.irodori.jpf.go.jp/starter/audio/lesson${pad}.html`} rel="noopener">『いろどり』入门 {l.irodori === 0 ? '教室用语' : `第 ${l.irodori} 课`}：原声</a></li>
              <li><a href={`https://www.irodori.jpf.go.jp/assets/data/starter/pdf/${l.irodori === 0 ? 'X_kyoshitsu' : `X_L${pad}`}.pdf`} rel="noopener">同课 PDF 教材</a></li>
            </>
          )}
          {l.kana && <li><a href="/kana/">本站假名表与笔顺动画</a></li>}
          {l.kana && <li><a href="https://minato-jf.jp/" rel="noopener">JF みなと 假名自学课</a></li>}
          {l.stage !== 'mountain' && <li><a href="https://www3.nhk.or.jp/nhkworld/lesson/zh/" rel="noopener">NHK 中文版「简明日语」</a></li>}
          {l.slug === 'kindai' && <li><a href="https://www.aozora.gr.jp/cards/000148/card789.html" rel="noopener">青空文库：吾輩は猫である</a></li>}
          {l.slug === 'kindai' && <li><a href="https://www.aozora.gr.jp/cards/000081/card45630.html" rel="noopener">青空文库：雨ニモマケズ</a></li>}
          {l.slug === 'next' && <li><a href="https://www.irodori.jpf.go.jp/elementary01/pdf.html" rel="noopener">『いろどり』初级 1（A2）</a></li>}
          {l.slug === 'next' && <li><a href="https://www.marugoto-online.jp/" rel="noopener">Marugoto 在线课程</a></li>}
          {l.slug === 'next' && <li><a href="https://www.jlpt.jp/samples/n5.html" rel="noopener">JLPT 官方 N5 样题</a></li>}
          {(l.slug === 'haiku' || l.slug === 'makura') && <li><a href="https://dl.ndl.go.jp/" rel="noopener">国立国会图书馆数字馆藏（古典原本）</a></li>}
        </ul>
      </section>
      <section>
        <h2>本课</h2>
        <ul>
          {prev && <li><a href={`/learn/${prev.slug}/`}>上一课</a></li>}
          <li><a href="/learn/">全部课程</a></li>
          <li><a href="/review/">复习卡片</a></li>
        </ul>
      </section>
    </aside>
  </div>
</Base>
