---
import Base from '../../layouts/Base.astro';
import Enso from '../../components/Enso.astro';
import { STAGES, lessonsOf } from '../../data/lessons/index.js';
import { ruby } from '../../lib/ruby.js';
import { romanize } from '../../lib/romaji.js';
import { levelsOf, grammarOf } from '../../data/course/index.js';
import works from '../../data/library/index.json';

const MORE = [
  ['https://www.irodori.jpf.go.jp/en/index.html', 'いろどり', '零基础到初中级，国际交流基金的免费教材和原声'],
  ['https://minato-jf.jp/', 'みなと', '国际交流基金的在线课程'],
  ['https://www3.nhk.or.jp/nhkworld/lesson/zh/', 'NHK 简明日语', '中文讲解的入门广播课'],
  ['https://tadoku.org/japanese/', 'NPO 多読', '从入门起步的分级读物'],
  ['https://www3.nhk.or.jp/news/easy/', 'News Web Easy', '中级开始读的简单新闻，有朗读'],
  ['https://aozoraroudoku.jp/', '青空朗読', '听文库里的文学作品'],
  ['https://www.jlpt.jp/samples/n5.html', 'JLPT 样题', '想测一下水平时用'],
];
const READ = { forest: ['N4'], fire: ['N3', 'N2'], mountain: ['N1'] };
const readCount = (key) => works.filter((w) => READ[key]?.includes(w.lv)).length;
---
<Base title="课程" desc="从假名到 N1 和原文阅读：主题课、分级词汇、语法与读物，学什么、学多少由你定。">
  <div class="page-head">
    <h1>课程</h1>
    <p>这里是一张地图，不是必须走完的路线。四个阶段只是告诉你各部分大概有多难，每一课都能单独打开。没有每日任务，也没有课数上限。第 6 到 23 课的主题与国际交流基金『いろどり 入门』相对应，可以配合它的原声一起听。</p>
  </div>
  {Object.entries(STAGES).map(([key, s]) => (
    <section class="stage-block" id={key} data-stage={key}>
      <div class="stage-title">
        <span class="brush" lang="ja">{s.kanji}</span>
        <h2>{s.name}</h2>
        <span lang="ja">{s.line}</span>
      </div>
      <p class="stage-note">{s.desc}</p>
      <ol class="lesson-list">
        {lessonsOf(key).map((l) => (
          <li>
            <a href={`/learn/${l.slug}/`} data-lesson={l.slug}>
              <Enso />
              <span class="l-n">{l.n}</span>
              <span class="l-title"><span lang="ja" set:html={ruby(l.title)} /><span class="ro">{romanize(l.title)}</span><span class="l-zh">{l.zh}</span></span>
            </a>
          </li>
        ))}
      </ol>
      {levelsOf(key).length > 0 && (
        <ul class="level-links">
          {levelsOf(key).map(([id, lv]) => (
            <li>
              <a href={`/words/?level=${id}`}><b>{lv.name} 词汇</b>{lv.words.length} 词</a>
              <a href={`/grammar/${id}/`}><b>{lv.name} 语法</b>{grammarOf(id).length} 个句型</a>
            </li>
          ))}
          {readCount(key) > 0 && <li><a href="/library/"><b>读原文</b>文库里有 {readCount(key)} 部这个难度的作品</a></li>}
        </ul>
      )}
    </section>
  ))}
  <section class="stage-block" id="more">
    <div class="stage-title"><h2>配着用的公开资料</h2></div>
    <ul class="level-links">
      {MORE.map(([u, t, x]) => <li><a href={u} rel="noopener"><b>{t}</b>{x}</a></li>)}
    </ul>
  </section>
</Base>
