---
import Base from '../../layouts/Base.astro';
import { kanji, GRADES, wordsWith } from '../../data/kanji.js';
import { gloss, auOf } from '../../data/course/index.js';
import { ruby } from '../../lib/ruby.js';
import { romanize } from '../../lib/romaji.js';
import { toRomaji } from '../../lib/kana.js';

export function getStaticPaths() {
  return kanji.map((k, i) => ({ params: { char: k.c }, props: { k, prev: kanji[i - 1], next: kanji[i + 1] } }));
}
const { k, prev, next } = Astro.props;
const grade = GRADES.find(([g]) => g === k.g)[1];
const words = wordsWith(k.c);
const start = (d) => d.match(/-?\d*\.?\d+/g).slice(0, 2).map(Number);
// よ.む is stem and okurigana; the dash marks a reading used only inside compounds.
const read = (r) => ({ stem: r.split('.')[0], oku: r.split('.')[1] ?? '', say: r.replace(/[.-]/g, ''), ro: toRomaji(r.replace(/[.-]/g, '')) });
---
<Base title={`${k.c}：笔顺和读音`} desc={`汉字「${k.c}」的动态笔顺（${k.d.length} 画）、音读、训读、罗马音和常用词。`} sysJa>
  <div class="page-head kanji-head">
    <div class="kanji-draw">
      <svg class="stroke" viewBox="0 0 109 109" role="img" aria-label={`${k.c} 的笔顺，共 ${k.d.length} 画`} id="k-svg">
        {k.d.map((d, i) => <path d={d} pathLength="1" style={`animation-delay:${i * 0.6}s`} />)}
        {k.d.map((d, i) => <text x={start(d)[0] - 6} y={start(d)[1] - 2} style={`animation-delay:${i * 0.6}s`}>{i + 1}</text>)}
      </svg>
      <button type="button" class="btn ghost" id="k-replay">再写一遍</button>
    </div>
    <div>
      <h1 lang="ja">{k.c}</h1>
      <p>{k.d.length} 画，{grade}{k.s && <>，简体写作「{k.s}」</>}</p>
      <p lang="en">{k.en.join(', ')}</p>
      {[['音読み', k.on], ['訓読み', k.kun]].map(([label, list]) => list.length > 0 && (
        <div class="readings">
          <h2 lang="ja">{label}</h2>
          <ul>
            {list.map((r) => {
              const x = read(r);
              return <li><button type="button" class="term" lang="ja" data-say={x.say}>{x.stem}{x.oku && <span class="oku">{x.oku}</span>}</button> <span class="ro">{x.ro}</span></li>;
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <div class="unit">
    {words.length > 0 && (
      <section class="sec">
        <div class="sec-h"><h2 lang="ja">言葉</h2><span>含这个字的词，常用的在前</span></div>
        {words.map((w) => (
          <div class="word">
            <h3 class="word-h">
              <button type="button" class="term" lang="ja" data-say={w.w} data-au={auOf(w)} set:html={ruby(w.ja)} />
              <span class="ro">{romanize(w.ja)}</span>
            </h3>
            <p class="gloss">{gloss(w)} <button type="button" class="add" data-add={w.w}>加入复习</button></p>
          </div>
        ))}
      </section>
    )}
    <nav class="pager" aria-label="相邻的字" lang="ja">
      {prev && <a href={`/kanji/${prev.c}/`}>{prev.c}</a>}
      <a href="/kanji/">全部汉字</a>
      {next && <a href={`/kanji/${next.c}/`}>{next.c}</a>}
    </nav>
    <p class="fine">笔顺：KanjiVG（CC BY-SA 3.0）。读音和释义：KANJIDIC2（CC BY-SA 4.0）。</p>
  </div>
  <script>
    document.getElementById('k-replay').addEventListener('click', () => {
      const svg = document.getElementById('k-svg');
      svg.replaceWith(svg.cloneNode(true)); // a fresh node restarts the CSS animation
    });
  </script>
</Base>
