---
import Base from '../layouts/Base.astro';
import { eras, EVENTS } from '../data/eras.js';
import { wiki } from '../data/wiki.js';
import { ruby } from '../lib/ruby.js';
import { romanize } from '../lib/romaji.js';
import works from '../data/library/index.json';

const title = (slug) => works.find((w) => w.slug === slug)?.title;
---
<Base title="日本史年表" desc="从绳文到令和的十六个时代，以及战国时期的大事，每一条都连到维基百科节选和可以直接读的原文。" stage="culture" sysJa>
  <div class="page-head">
    <h1>日本史年表</h1>
    <p>早期的起止年代有争议，这里取通行的说法。每个时代旁边的一句话来自中文维基百科（<a href="https://creativecommons.org/licenses/by-sa/4.0/deed.zh-hans" rel="noopener">CC BY-SA 4.0</a>），点进去有日文原文和出处。</p>
  </div>
  <ol class="era-list">
    {eras.map((e) => (
      <li>
        <span class="era-name brush" lang="ja" set:html={ruby(e.ja)} />
        <div>
          <p class="ro">{romanize(e.ja)}</p>
          <span class="era-span">{e.span}</span>
          <p>{wiki[e.to]?.summary}{wiki[e.to] && <a href={`/culture/${e.to}/`}>　读维基百科节选</a>}</p>
        </div>
      </li>
    ))}
  </ol>
  <section class="stage-block" id="sengoku">
    <h2>战国细表</h2>
    <p class="stage-note">从应仁之乱到岛原之乱。条目连着维基百科节选，后面是文库里写这件事的日语原文。</p>
    <ol class="timeline">
      {EVENTS.map(([y, slug, lib]) => (
        <li>
          <b>{y}</b>
          <span>
            {wiki[slug] && <a href={`/culture/${slug}/`} lang="ja">{wiki[slug].ja}</a>}{wiki[slug]?.zh && `（${wiki[slug].zh}）`}
            {lib && title(lib) && <a href={`/library/${lib}/`} lang="ja">　原文：{title(lib)}</a>}
          </span>
        </li>
      ))}
    </ol>
  </section>
</Base>
