---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import { STAGES } from '../data/stages.js';
import { CATS } from '../data/eras.js';
import { LEVELS } from '../data/course/index.js';
import { topics } from '../data/wiki.js';
import toc from '../data/grammar/index.json';
import { anime } from '../data/anime.js';
import { scenes } from '../data/scenes.js';
import { ruby } from '../lib/ruby.js';
import works from '../data/library/index.json';

const totalWords = Object.values(LEVELS).reduce((n, l) => n + l.words.length, 0);
const POS = { wind: '60% 30%', forest: 'center 35%', fire: 'center 22%', mountain: 'center 40%' };
const DOORS = [
  ['/kana/', '五十音', '笔顺动画、字源和发音。'],
  ['/grammar/', `${toc.length} 页语法`, 'Tae Kim《日语语法指南》中文版全文，含原书练习。'],
  ['/words/', `${totalWords} 个词`, '母语者例句，能配真人录音的都配了。'],
  ['/kanji/', '常用汉字', '2136 字的笔顺、音读训读和用词。'],
  ['/anime/', `${anime.length} 部动漫`, '作品里的词、母语者例句和维基百科介绍。'],
  ['/scenes/', `${scenes.length} 个情景`, '便利店、车站、温泉、居酒屋、神社。'],
  ['/library/', `${works.length} 部原文`, '青空文库的日本文学全文。'],
];
---
<Base home title="風林火山：从零到读原文的日语学习站" desc={`从五十音到 N1 和原文阅读。Tae Kim 语法、${totalWords} 个词、${works.length} 部原文，都来自公开的正规资料并带罗马音。免费，不用注册。`}>
  <div class="home-grid">
    <section class="hero" aria-labelledby="site-title">
      <h1 class="banner brush" id="site-title" lang="ja">風林火山</h1>
      <div class="hero-text">
        <p class="lede">不用注册，也没有学习计划。想学什么，就从什么开始。</p>
        <p>语法、练习和读物都来自公开的正规资料，每页标明出处。日语都带罗马音，进度只保存在你的浏览器里。</p>
        <p id="mine"></p>
        <a class="cta" href="/kana/">从五十音开始</a>
        <div class="today" id="today"></div>
      </div>
    </section>
    <div class="bands">
      {Object.entries(STAGES).map(([key, s]) => (
        <a class="band" href={`/learn/#${key}`} data-stage={key} style={`--pos:${POS[key]}`}>
          <Art name={s.art} caption={false} sizes="(max-width: 34rem) 70vw, (max-width: 62rem) 60vw, 28vw" eager widths={[320, 640]} />
          <p class="glyph brush" lang="ja"><Fragment set:html={ruby(`${s.kanji}{${s.yomi}}`)} /></p>
          <div>
            <h2><span class="line brush" lang="ja">{s.line}</span>{s.name}</h2>
            <p>{s.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
  <section class="doors" aria-label="从这里开始">
    {DOORS.map(([href, t, x]) => <a class="door" href={href}><strong>{t}</strong><span>{x}</span></a>)}
  </section>
  <section class="home-culture">
    <h2>语言长在文化里</h2>
    <p>{topics.length} 个主题，日语和中文都节选自维基百科，讲日本的历史、文学、美学、饮食，以及它和中国古代文化的来往。</p>
    <ul class="cats">
      {Object.entries(CATS).map(([k, c]) => <li><a href={`/culture/#${k}`}>{c.zh}</a></li>)}
      <li><a href="/history/">日本史年表</a></li>
      <li><a href="/history/#sengoku">战国细表</a></li>
    </ul>
  </section>
  <script>import '../scripts/home.js';</script>
</Base>
