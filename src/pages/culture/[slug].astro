---
import Base from '../../layouts/Base.astro';
import Art from '../../components/Art.astro';
import Controls from '../../components/Controls.astro';
import WikiText from '../../components/WikiText.astro';
import WikiImage from '../../components/WikiImage.astro';
import { topics } from '../../data/wiki.js';
import { romanize } from '../../lib/romaji.js';

export const getStaticPaths = () => topics.map((w) => ({ params: { slug: w.slug }, props: { w } }));
const { w } = Astro.props;
---
<Base title={w.zh ?? w.ja} desc={w.summary || w.ja} stage="culture" sysJa>
  <header class="essay-head">
    <p class="crumb"><a href={`/culture/#${w.cat}`}>文化</a></p>
    <h1 lang="ja">{w.ja}</h1>
    <p class="ro head-ro">{romanize(w.ja)}</p>
    {w.zh && <p class="sum">{w.zh}</p>}
  </header>
  <Controls zh={false} />
  <article class="essay">
    {w.art ? <Art name={w.art} eager /> : <WikiImage img={w.img} alt={w.ja} eager />}
    <div class="prose">
      <WikiText w={w} />
    </div>
    {w.art2 && <Art name={w.art2} />}
  </article>
</Base>
