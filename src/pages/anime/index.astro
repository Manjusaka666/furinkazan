---
import Base from '../../layouts/Base.astro';
import Enso from '../../components/Enso.astro';
import { ANIME_GROUPS, PLACES, anime } from '../../data/anime.js';
import { ruby } from '../../lib/ruby.js';
import { romanize } from '../../lib/romaji.js';
---
<Base title="动漫" desc={`通过 ${anime.length} 部日本动漫学日语：角色的说话方式、名台词的语法、作品里的词，还有可以去走一走的圣地。`} sysJa>
  <div class="page-head">
    <h1>动漫</h1>
    <p>看过哪部就从哪部开始：角色怎么说话，名台词的语法，作品里常见的词，还有作品连着的历史、文学和现实中的地方。本站不放动画画面和字幕，作品请到正版平台观看。</p>
  </div>
  {ANIME_GROUPS.map(([name, list]) => (
    <section class="stage-block">
      <h2>{name}</h2>
      <ul class="lesson-list topic-grid">
        {list.map((a) => (
          <li>
            <a class="topic" href={`/anime/${a.slug}/`} data-lesson={`anime-${a.slug}`}>
              <Enso />
              <span class="l-title"><span lang="ja" set:html={ruby(a.ja)} /><span class="ro">{romanize(a.ja)}</span><span class="l-zh">{a.zh}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <section class="stage-block" id="places">
    <h2>更多圣地</h2>
    <p class="stage-note">「聖地巡礼」是去动漫的取景地走走。各作品页里还有对应的地点，也可以看<a href="https://animetourism88.com/" rel="noopener">动漫旅游协会的「日本动漫圣地 88」</a>。</p>
    <ul class="place-list">
      {PLACES.map((p) => (
        <li>
          <strong lang="ja" set:html={ruby(p.n)} /> <span class="ro">{romanize(p.n)}</span>
          <p>{p.pref}。{p.work}。{p.x}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
