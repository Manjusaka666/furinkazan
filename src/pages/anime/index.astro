---
import Base from '../../layouts/Base.astro';
import Enso from '../../components/Enso.astro';
import { ANIME_GROUPS, anime } from '../../data/anime.js';
import { ruby } from '../../lib/ruby.js';
import { romanize } from '../../lib/romaji.js';
---
<Base title="动漫" desc={`${anime.length} 部日本动漫的相关词汇、母语者例句和维基百科介绍。`} sysJa>
  <div class="page-head">
    <h1>动漫</h1>
    <p>看过哪部就从哪部开始。每部有作品相关的词、母语者例句和维基百科的介绍。除吉卜力官方开放的剧照外，本站不放动画画面、字幕和台词，作品请到正版平台观看。<a href="https://animetourism88.com/" rel="noopener">动漫旅游协会的「日本动漫圣地 88」</a>可以查现实中的取景地。</p>
  </div>
  {ANIME_GROUPS.map(([name, list]) => (
    <section class="stage-block">
      <h2>{name}</h2>
      <ul class="lesson-list topic-grid">
        {list.map((a) => (
          <li>
            <a class="topic" href={`/anime/${a.slug}/`} data-lesson={`anime-${a.slug}`}>
              <Enso />
              <span class="l-title"><span lang="ja" set:html={ruby(a.ja)} /><span class="ro">{romanize(a.ja)}</span><span class="l-zh">{a.zh}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
