---
import Base from '../../layouts/Base.astro';
import Controls from '../../components/Controls.astro';
import WordList from '../../components/WordList.astro';
import WikiText from '../../components/WikiText.astro';
import { anime } from '../../data/anime.js';
import { wiki } from '../../data/wiki.js';
import { STILLS } from '../../data/stills.js';
import { topicWords } from '../../data/course/index.js';
import { ruby, plain } from '../../lib/ruby.js';
import { romanize } from '../../lib/romaji.js';

export const getStaticPaths = () => anime.map((a) => ({ params: { slug: a.slug }, props: { a } }));
const { a } = Astro.props;
const w = wiki[`anime-${a.slug}`];
const stills = STILLS[a.slug];
---
<Base title={`${a.zh}（${plain(a.ja)}）`} desc={`${a.zh}的相关日语词汇、母语者例句和维基百科介绍。`} sysJa>
  <header class="lesson-head">
    <p class="crumb"><a href="/anime/">动漫</a></p>
    <h1 lang="ja" set:html={ruby(a.ja)} />
    <p class="ro head-ro">{romanize(a.ja)}</p>
    <p class="sub">{a.zh}。{a.by}，{a.year}</p>
  </header>
  <Controls />
  <article class="unit">
    {stills && (
      <section class="sec stills">
        {stills.files.map((f, i) => <img src={f} alt={`${a.zh} 官方剧照 ${i + 1}`} width="960" height="520" loading="lazy" decoding="async" />)}
        <p class="credit">官方剧照 © Studio Ghibli。吉卜力在<a href="https://www.ghibli.jp/info/013344/" rel="noopener">官网</a>提供这些图片并请大家在常识范围内自由使用，<a href={stills.page} rel="noopener">更多剧照</a>。</p>
      </section>
    )}
    {w && <section class="sec"><WikiText w={w} /></section>}
    <WordList words={topicWords(a.slug)} id={`anime-${a.slug}`}>
      {a.ties.map(([href, label]) => <a href={href}>{label}</a>)}
    </WordList>
  </article>
</Base>
