---
import Base from '../../layouts/Base.astro';
import Controls from '../../components/Controls.astro';
import { ruby } from '../../lib/ruby.js';

export const getStaticPaths = () =>
  Object.entries(import.meta.glob('../../data/library/*.json', { eager: true }))
    .filter(([path]) => !path.endsWith('/index.json'))
    .map(([, m]) => ({ params: { slug: m.default.slug }, props: { w: m.default } }));

const { w } = Astro.props;
---
<Base title={w.title} desc={`${w.author}『${w.title}』日语原文，来自青空文库，带罗马音。`} sysJa>
  <header class="lesson-head">
    <p class="crumb"><a href={`/library/#${w.cat}`}>文库</a>　难度约 {w.lv}，约 {Math.round(w.chars / 100) / 10} 千字</p>
    <h1 lang="ja">{w.title}</h1>
    {w.subtitle && <p class="sub" lang="ja">{w.subtitle}</p>}
    <p class="sub" lang="ja">{w.author}{w.translator && `　${w.translator} 訳`}</p>
  </header>
  <Controls zh={false} />
  <article class="reader">
    <p class="guide">作者去世于 1955 年以前，用词和今天不完全相同。{/旧/.test(w.kana) ? '本文用历史假名，罗马音按现代读法生成，仅供参考。' : '罗马音由程序生成，以原文的振假名为准。'}</p>
    <div class="text" id="text" lang="ja" data-slug={w.slug}>
      {w.paras.map((p) => <p set:html={ruby(p)} />)}
    </div>
    <p class="credit">
      底本：<span lang="ja">{w.base}</span>。入力：<span lang="ja">{w.input}</span>，校正：<span lang="ja">{w.proof}</span>。
      <a href={w.card} rel="noopener">青空文库图书卡</a>。{w.kana === '旧字旧仮名' || w.kana === '新字旧仮名' ? '本文保留历史假名用法。' : ''}
    </p>
    <div class="finish">
      <button type="button" class="btn" data-finish={`read-${w.slug}`} data-vocab="[]" data-done-text="已读完">读完了</button>
      <a href="/library/">回到文库</a>
    </div>
  </article>
  <script>import '../../scripts/reader.js';</script>
</Base>
